{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "paths": {
      "@spartan-ng/helm/accordion": [
        "./libs/ui/ui-accordion-helm/src/index.ts"
      ],
      
"spartan-ui-lib": ["./projects/spartan-ui-lib/src/public-api.ts"],
   "spartan-ui-component-lib": ["./node_modules/spartan-ui-component-lib"],
  

      "@spartan-ng/helm/button": [
        "./libs/ui/ui-button-helm/src/index.ts"
      ],
      "@spartan-ng/helm/calendar": [
        "./libs/ui/ui-calendar-helm/src/index.ts"
      ],
      "@spartan-ng/helm/checkbox": [
        "./libs/ui/ui-checkbox-helm/src/index.ts"
      ],
      "@spartan-ng/helm/form-field": [
        "./libs/ui/ui-form-field-helm/src/index.ts"
      ],
      "@spartan-ng/helm/icon": [
        "./libs/ui/ui-icon-helm/src/index.ts"
      ],
      "@spartan-ng/helm/input": [
        "./libs/ui/ui-input-helm/src/index.ts"
      ],
      "@spartan-ng/helm/switch": [
        "./libs/ui/ui-switch-helm/src/index.ts"
      ],
      "@spartan-ng/helm/typography": [
        "./libs/ui/ui-typography-helm/src/index.ts"
      ],
      "@spartan-ng/helm/utils": [
        "./libs/ui/ui-button-helm/src/lib/utils.ts"
      ],
      "@spartan-ng/helm/select": [
        "./libs/ui/ui-select-helm/src/index.ts"
      ],
      "@spartan-ng/helm/label": [
        "./libs/ui/ui-label-helm/src/index.ts"
      ],
      "@spartan-ng/helm/date-picker": [
        "./libs/ui/ui-date-picker-helm/src/index.ts"
      ],
      "@spartan-ng/helm/popover": [
        "./libs/ui/ui-popover-helm/src/index.ts"
      ],
      "@spartan-ng/helm/skeleton": [
        "./libs/ui/ui-skeleton-helm/src/index.ts"
      ],
      "@spartan-ng/helm/avatar": [
        "./libs/ui/ui-avatar-helm/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
